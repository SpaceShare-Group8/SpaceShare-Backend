{
  "info": {
    "name": "SpaceShare API — Full Live Coverage",
    "description": "Every endpoint actually mounted in app.js as of the final patch, verified by booting the real server against a live database. Endpoints that exist in code but aren't reachable (e.g. the old unmounted payment module) are excluded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "rootUrl", "value": "http://localhost:4000" },
    { "key": "seekerToken", "value": "" },
    { "key": "hostToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "workspaceId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "photoId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{rootUrl}}/health" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/register", "body": {"mode":"raw","raw":"{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Test User\",\n  \"phone\": \"+2348011112222\",\n  \"role\": \"seeker\"\n}"} } },
        { "name": "Login", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/login", "body": {"mode":"raw","raw":"{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"} } },
        { "name": "Refresh Token", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/refresh", "body": {"mode":"raw","raw":"{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"} } },
        { "name": "Forgot Password", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/forgot-password", "body": {"mode":"raw","raw":"{\n  \"email\": \"user@example.com\"\n}"} } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/auth/reset-password", "body": {"mode":"raw","raw":"{\n  \"token\": \"reset-token-here\",\n  \"password\": \"NewPassword123!\"\n}"} } },
        { "name": "Get Me", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{seekerToken}}"}], "url": "{{baseUrl}}/auth/me" } }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        { "name": "Create Workspace (Host)", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/workspaces", "body": {"mode":"raw","raw":"{\n  \"title\": \"Quiet Desk Lagos\",\n  \"workspace_type\": \"desk\",\n  \"capacity\": 2,\n  \"city\": \"Lagos\",\n  \"address\": \"12 Adeola Odeku St\",\n  \"latitude\": 6.4281,\n  \"longitude\": 3.4219\n}"} } },
        { "name": "List Workspaces (filters)", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces?city=Lagos&minCapacity=1&minPrice=500&maxPrice=5000&amenities=wifi,parking&minReliabilityScore=50" } },
        { "name": "Search Workspaces", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/search?latitude=6.5244&longitude=3.3792&radius=10" } },
        { "name": "Find Me Power Now", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/find-me-power-now?lat=6.5244&lng=3.3792" } },
        { "name": "Get Workspace by ID", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/{{workspaceId}}" } },
        { "name": "Update Workspace (Host)", "request": { "method": "PUT", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/workspaces/{{workspaceId}}", "body": {"mode":"raw","raw":"{\n  \"title\": \"Updated title\"\n}"} } },
        { "name": "Delete Workspace (Host)", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"}], "url": "{{baseUrl}}/workspaces/{{workspaceId}}" } },
        { "name": "Upload Workspace Photo (Host)", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"}], "url": "{{baseUrl}}/workspaces/{{workspaceId}}/photos", "body": {"mode":"formdata","formdata":[{"key":"photo","type":"file","src":""}]} } },
        { "name": "List Workspace Photos", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/{{workspaceId}}/photos" } },
        { "name": "Delete Workspace Photo (Host)", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"}], "url": "{{baseUrl}}/workspaces/{{workspaceId}}/photos/{{photoId}}" } },
        { "name": "Update Workspace Status (Admin)", "request": { "method": "PATCH", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/workspaces/{{workspaceId}}/status", "body": {"mode":"raw","raw":"{\n  \"status\": \"published\"\n}"} } },
        { "name": "Get Reliability Score", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/{{workspaceId}}/reliability-score" } }
      ]
