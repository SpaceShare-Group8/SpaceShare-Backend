        { "name": "Get Workspace Availability", "request": { "method": "GET", "url": "{{baseUrl}}/workspaces/{{workspaceId}}/availability?date=2026-08-20" } },
        { "name": "Update Availability Slot (Host)", "description": "Path fixed — was colliding with DELETE /workspaces/:id before the routing fix.", "request": { "method": "PATCH", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{baseUrl}}/workspaces/availability/{{availabilityId}}", "body": {"mode":"raw","raw":"{\n  \"is_blocked\": true\n}"} } },
        { "name": "Delete Availability Slot (Host)", "description": "Path fixed — was colliding with DELETE /workspaces/:id before the routing fix.", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{hostToken}}"}], "url": "{{baseUrl}}/workspaces/availability/{{availabilityId}}" } }
      ]
